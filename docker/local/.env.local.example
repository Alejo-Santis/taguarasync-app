##############################################################################
# Taguara Sync — Variables de entorno para servidor LOCAL (farmacia)
# Copiar este archivo como .env y completar los valores
##############################################################################

APP_NAME="TaguaraSync"
APP_ENV=production
APP_KEY=          # generar con: php artisan key:generate --show
APP_DEBUG=false
APP_URL=http://localhost

# ── Modo de operación ─────────────────────────────────────────────────────
APP_MODE=local
SERVER_ID=local-farmacia-001   # cambiar por un slug único de esta farmacia

# ── Cloud sync ────────────────────────────────────────────────────────────
CLOUD_SYNC_URL=https://app.taguara.co
CLOUD_SYNC_SECRET=             # compartido con el servidor cloud

# ── Base de datos ─────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=taguara_local
DB_USERNAME=taguara
DB_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ── Conectividad ──────────────────────────────────────────────────────────
SYNC_PING_HOST=8.8.8.8
SYNC_PING_PORT=53
SYNC_CONNECTIVITY_TTL=3
SYNC_PING_TIMEOUT=2
SYNC_INTERVAL=5
SYNC_BATCH_SIZE=100
SYNC_FE_CONTINGENCY_MAX_HOURS=48

# ── Facturación Electrónica ───────────────────────────────────────────────
FE_API_URL=https://api.nextpyme.plus/api
FE_API_TOKEN=
FE_ENABLED=true

# ── Correo (opcional en local) ────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS=soporte@taguara.co
MAIL_FROM_NAME="TaguaraSync"
