##############################################################################
# Taguara Sync — Variables de entorno para el servidor CLOUD (piloto EC2)
# Copiar este archivo como .env y completar los valores
##############################################################################

APP_NAME="TaguaraSync"
APP_ENV=production
# Generar con: docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# IP pública de la instancia (http://X.X.X.X) o tu dominio si ya tienes uno
APP_URL=http://localhost

# ── Modo de operación ─────────────────────────────────────────────────────
# cloud: no actives el modo local aquí. Este es el servidor "de verdad".
APP_MODE=cloud

# ── Base de datos ─────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=taguara_cloud
DB_USERNAME=taguara
DB_PASSWORD=

# ── Colas, cache y sesión (sin Redis — database es suficiente para el piloto) ─
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# ── Correo — usar credenciales reales, NO el sandbox de Mailtrap ──────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=soporte@taguara.co
MAIL_FROM_NAME="TaguaraSync"

# ── Facturación Electrónica — credenciales de producción de Nextpyme ──────
FE_API_URL=https://api.nextpyme.plus/api
FE_API_TOKEN=
FE_ENABLED=true

# ── Sync con servidores locales (dejar vacío si aún no hay ninguno) ───────
# Si más adelante instalas un servidor local en una farmacia, genera un
# secreto con: openssl rand -hex 32 — y ponlo aquí y en el .env del local.
CLOUD_SYNC_SECRET=
